        "summary": "Unregister Profile Event",
        "description": "",
        "operationId": "payplatform_payments_unregister_profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "accountId",
                  "gatewayProfileId"
                ],
                "properties": {
                  "accountId": {
                    "type": "string",
                    "description": "The ID of the account the gateway profile belongs to."
                  },
                  "gatewayProfileId": {
                    "type": "string",
                    "description": "The ID of the profile being unregistered."
                  }
                }
              },
              "examples": {
                "Unregister profile": {
                  "value": {
                    "accountId": "account-123",
                    "gatewayProfileId": "gateway-profile-123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Result": {
                    "value": "{}"
                  }
                },
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          }
        },
        "deprecated": false,
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
