    "/pay/events/{integrationName}/gatewayProfiles/{gatewayProfileId}": {
      "post": {
        "summary": "Payment Events",
        "description": "",
        "operationId": "post_pay-events-integrationname-gatewayprofiles-gatewayprofileid",
        "parameters": [
          {
            "in": "path",
            "name": "integrationName",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "gatewayProfileId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "title": "Payment update",
                    "type": "object",
                    "required": [
                      "eventType",
                      "gatewayId",
                      "status",
                      "method"
                    ],
                    "properties": {
                      "eventType": {
                        "type": "string",
                        "enum": [
                          "payment_update"
                        ]
                      },
                      "gatewayId": {
                        "type": "string",
                        "example": "pay_gateway_123456"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "refused",
                          "authorized"
                        ]
                      },
                      "failureReason": {
                        "type": "string",
                        "example": "Insufficient Funds"
                      },
                      "method": {
                        "type": "string",
                        "example": "visa"
                      }
                    }
                  },
                  {
                    "title": "Refund update",
                    "type": "object",
                    "required": [
                      "eventType",
                      "gatewayId",
                      "status"
                    ],
                    "properties": {
                      "eventType": {
                        "type": "string",
                        "enum": [
                          "refund_update"
                        ]
                      },
                      "gatewayId": {
                        "type": "string",
                        "example": "refund_gateway_123456"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "failed",
                          "succeeded"
                        ]
                      },
                      "failureReason": {
                        "type": "string",
                        "example": "reason for refund failure"
                      }
                    }
                  }
                ]
              },
              "examples": {
                "Refund Failed": {
                  "summary": "Refund Failed",
                  "value": {
                    "eventType": "refund_update",
                    "gatewayId": "refund_gateway_123456",
                    "status": "failed",
                    "failureReason": "reason for refund failure"
                  }
                },
                "Refunded": {
