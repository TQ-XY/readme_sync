    "/pay/channel/{channelLinkId}/payments/request": {
      "post": {
        "summary": "Request Payment",
        "description": "",
        "operationId": "pay_endpoints-request-payment",
        "parameters": [
          {
            "name": "channelLinkId",
            "in": "path",
