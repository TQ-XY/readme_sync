    "/validate_job": {
      "post": {
        "responses": {
          "200": {
            "description": "200",
            "content": {
              "application/json": {
                "examples": {
                  "Can Deliver": {
                    "summary": "Can Deliver",
                    "value": {
                      "jobId": "62*****************9a",
                      "canDeliver": true,
                      "distance": 10,
                      "pickupTimeETA": "2022-05-10T14:47:31.649000Z",
                      "deliveryLocations": [
                        {
                          "deliveryId": "AB**67",
                          "orderId": "62*******************37",
                          "deliveryTimeETA": "2022-05-10T14:57:31.649000Z"
                        }
                      ],
                      "price": {
                        "price": 750,
                        "taxRate": 10000
                      }
                    }
                  },
                  "Cannot Deliver": {
                    "summary": "Cannot Deliver",
                    "value": {
                      "jobId": "651******************22a",
                      "canDeliver": false,
                      "errors": [
                        {
                          "deliveryId": "J****FI",
                          "orderId": "651******************215",
                          "channelOrderDisplayId": "",
                          "reason": 20,
                          "description": "No drivers available at this time"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "oneOf": [
                    {
                      "title": "Deliverable job",
                      "type": "object",
                      "required": [
                        "jobId",
                        "canDeliver",
                        "distance",
                        "pickupTimeETA",
                        "deliveryLocations",
                        "price"
                      ],
                      "properties": {
                        "jobId": {
                          "type": "string",
                          "example": "62*****************9a"
                        },
                        "canDeliver": {
                          "type": "boolean",
                          "enum": [
                            true
                          ],
                          "description": "Whether a courier is available for the delivery job.",
                          "example": true
                        },
                        "distance": {
                          "type": "integer",
                          "example": 10
                        },
                        "pickupTimeETA": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2022-05-10T14:47:31.649000Z"
                        },
                        "deliveryLocations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "deliveryId",
                              "orderId",
                              "deliveryTimeETA"
                            ],
                            "properties": {
                              "deliveryId": {
                                "type": "string",
                                "example": "AB**67"
                              },
                              "orderId": {
                                "type": "string",
                                "example": "62*******************37"
                              },
                              "deliveryTimeETA": {
                                "type": "string",
                                "format": "date-time",
                                "example": "2022-05-10T14:57:31.649000Z"
                              }
                            }
                          }
                        },
                        "price": {
                          "type": "object",
                          "required": [
                            "price",
                            "taxRate"
                          ],
                          "properties": {
                            "price": {
                              "type": "integer",
                              "example": 750
                            },
                            "taxRate": {
                              "type": "integer",
                              "example": 10000
                            }
                          }
                        }
                      }
                    },
                    {
                      "title": "Undeliverable job",
                      "type": "object",
                      "required": [
                        "jobId",
                        "canDeliver",
                        "errors"
                      ],
                      "properties": {
                        "jobId": {
                          "type": "string",
                          "example": "651******************22a"
                        },
                        "canDeliver": {
                          "type": "boolean",
                          "enum": [
                            false
                          ],
                          "description": "Whether a courier is available for the delivery job.",
                          "example": false
                        },
                        "errors": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "deliveryId",
                              "orderId",
                              "channelOrderDisplayId",
                              "reason",
                              "description"
                            ],
                            "properties": {
                              "deliveryId": {
                                "type": "string",
                                "example": "J****FI"
                              },
                              "orderId": {
                                "type": "string",
                                "example": "651******************215"
                              },
                              "channelOrderDisplayId": {
                                "type": "string",
                                "example": ""
                              },
                              "reason": {
                                "type": "integer",
                                "example": 20
                              },
                              "description": {
                                "type": "string",
                                "example": "No drivers available at this time"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "examples": {
                  "Bad Request": {
                    "summary": "Bad Request",
                    "value": "{}"
                  }
                }
